<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd"
        logicalFilePath="notification.changelog.xml">

    <changeSet id="notification-07.06.2019-11:13" author="isv" context="common">
        <comment>Create pushmessages table</comment>
        <sql>
            CREATE TABLE pushmessages (
                id INT NOT NULL AUTO_INCREMENT,
                messageType VARCHAR(50) NOT NULL,
                deviceId INT NOT NULL,
                payload TEXT,
                CONSTRAINT push_message_pr_key PRIMARY KEY (id),
                CONSTRAINT push_message_deviceId_fkey FOREIGN KEY (deviceId) REFERENCES devices(id) ON DELETE CASCADE
            ) ENGINE=InnoDB;
        </sql>
        <rollback>
            DROP TABLE pushmessages;
        </rollback>
    </changeSet>

    <changeSet id="notification-07.06.2019-11:45" author="isv" context="common">
        <comment>Create pendingpushes table</comment>
        <sql>
            CREATE TABLE pendingpushes (
                id INT NOT NULL AUTO_INCREMENT,
                messageId INT NOT NULL,
                status INT NOT NULL DEFAULT 0,
                createTime BIGINT NOT NULL,
                sendTime BIGINT,
                CONSTRAINT pending_push_pr_key PRIMARY KEY (id),
                CONSTRAINT pending_push_messageId_unq UNIQUE (messageId),
                CONSTRAINT pending_push_messageId_fkey FOREIGN KEY (messageId) REFERENCES pushmessages(id) ON DELETE CASCADE
            ) ENGINE=InnoDB;
        </sql>
        <rollback>
            DROP TABLE pendingpushes;
        </rollback>
    </changeSet>

</databaseChangeLog>